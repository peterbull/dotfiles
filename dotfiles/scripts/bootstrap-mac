#!/bin/bash

install=0
link=0
link_skills=0
link_codex=0
backup=0
dry=0
help=0
backup_dir=
names=(settings.json keybindings.json)

usage() {
    printf '%s\n' 'Usage: bootstrap-mac [--dry-run | --install] [--link-vscode [--backup]] [--link-agent-skills] [--link-codex-instructions] [--help]' \
        'No arguments preview the base Brewfile install, two VS Code links, shared agent skills and Codex instructions links.'
}

fail() {
    printf 'Error: %s\n' "$1" >&2
    printf 'No automatic rollback; any previously completed actions remain.\n' >&2
    if [ -n "$backup_dir" ]; then
        printf 'Preserved backups: %s (manual recovery; prior actions remain).\n' "$backup_dir" >&2
    fi
    exit "${2:-1}"
}

for arg in "$@"; do
    case "$arg" in
        --install) install=1 ;;
        --link-vscode) link=1 ;;
        --link-agent-skills) link_skills=1 ;;
        --link-codex-instructions) link_codex=1 ;;
        --backup) backup=1 ;;
        --dry-run) dry=1 ;;
        --help) help=1 ;;
        *) fail "Unknown flag: $arg" 2 ;;
    esac
done
[ "$backup" -eq 0 ] || [ "$link" -eq 1 ] || fail '--backup requires --link-vscode' 2
if [ "$dry" -eq 1 ] && { [ "$install" -eq 1 ] || [ "$link" -eq 1 ] || [ "$link_skills" -eq 1 ] || [ "$link_codex" -eq 1 ] || [ "$backup" -eq 1 ]; }; then
    fail '--dry-run cannot accompany mutating flags' 2
fi
if [ "$help" -eq 1 ]; then
    usage
    exit 0
fi

case "${HOME:-}" in
    /*) [ -d "$HOME" ] || fail 'HOME must be an existing absolute directory' ;;
    *) fail 'HOME must be an existing absolute directory' ;;
esac
home=$(CDPATH= cd -P -- "$HOME" && pwd -P) || fail 'Cannot resolve HOME'
repo=$(CDPATH= cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P) || fail 'Cannot resolve repository'
platform=$(uname -s) || fail 'Cannot determine platform'
[ "$platform" = Darwin ] || fail "macOS (Darwin) required; platform is $platform"

preview=0
if [ "$install" -eq 0 ] && [ "$link" -eq 0 ] && [ "$link_skills" -eq 0 ] && [ "$link_codex" -eq 0 ]; then
    preview=1
fi
brewfile="$repo/Brewfile"
user_dir="$home/Library/Application Support/Code/User"
backup_base="$home/Library/Application Support/dotfiles-backups"
skills_source="$home/peter-projects/pi-config/skills"
agents_dir="$home/.agents"
skills_target="$agents_dir/skills"
codex_source="$home/peter-projects/pi-config/AGENTS.md"
codex_dir="$home/.codex"
codex_target="$codex_dir/AGENTS.md"

# Walk from canonical HOME without traversing symlinked ancestors.
check_parents() {
    local remaining current component problem
    remaining=${1#"$home"/}
    current=$home
    while [ -n "$remaining" ]; do
        component=${remaining%%/*}
        if [ "$remaining" = "$component" ]; then
            remaining=
        else
            remaining=${remaining#*/}
        fi
        current="$current/$component"
        problem=
        if [ -L "$current" ]; then
            problem="Symlinked ancestor refused: $current"
        elif [ -e "$current" ] && [ ! -d "$current" ]; then
            problem="Non-directory ancestor refused: $current"
        fi
        if [ -n "$problem" ]; then
            if [ "${2:-0}" -eq 1 ]; then
                prerequisite_problem "$problem"
                return 1
            fi
            fail "$problem"
        fi
    done
}

check_target() {
    local source target
    source="$repo/.vscode/$1"
    target="$user_dir/$1"
    [ -f "$source" ] || fail "Missing regular VS Code source: $source"
    [ ! -d "$target" ] || fail "Directory target refused: $target"
    if [ -e "$target" ] && [ ! -f "$target" ] && [ ! -L "$target" ]; then
        fail "Special filesystem target refused: $target"
    fi
    target_state=new
    if [ "$target" -ef "$source" ]; then
        target_state=correct
    elif [ -e "$target" ] || [ -L "$target" ]; then
        target_state=conflict
        if [ "$backup" -eq 0 ]; then
            if [ "$preview" -eq 1 ]; then
                printf 'Warning: conflict requires --link-vscode --backup: %s\n' "$target"
            else
                fail "Conflict requires --backup: $target"
            fi
        fi
    fi
}

check_links() {
    local name
    check_parents "$user_dir"
    if [ "$backup" -eq 1 ]; then
        check_parents "$backup_base"
    fi
    for name in "${names[@]}"; do
        check_target "$name"
    done
}

prerequisite_problem() {
    if [ "$preview" -eq 1 ]; then
        printf 'Warning: %s\n' "$1"
    else
        fail "$1"
    fi
}

check_skills_link() {
    skills_state=new
    if [ ! -d "$skills_source" ]; then
        skills_state=unavailable
        prerequisite_problem "Missing directory agent skills source: $skills_source"
    fi
    if ! check_parents "$agents_dir" "$preview"; then
        skills_state=conflict
        return
    fi
    if [ -L "$skills_target" ] && [ "$skills_target" -ef "$skills_source" ]; then
        skills_state=correct
    elif [ -e "$skills_target" ] || [ -L "$skills_target" ]; then
        skills_state=conflict
        prerequisite_problem "Agent skills target conflict; no replacement or backup: $skills_target"
    fi
}

check_codex_link() {
    codex_state=new
    if [ -n "${CODEX_HOME:-}" ] && [ "$CODEX_HOME" != "$codex_dir" ] && [ "$CODEX_HOME" != "$HOME/.codex" ]; then
        codex_state=unavailable
        prerequisite_problem "Non-default CODEX_HOME is unsupported; default Codex instructions would be ignored: $CODEX_HOME"
        return
    fi
    if [ ! -f "$codex_source" ] || [ ! -r "$codex_source" ] || [ ! -s "$codex_source" ]; then
        codex_state=unavailable
        prerequisite_problem "Missing, empty or unreadable regular Codex instructions source: $codex_source"
    fi
    if ! check_parents "$codex_dir" "$preview"; then
        codex_state=conflict
        return
    fi
    if [ -s "$codex_dir/AGENTS.override.md" ]; then
        codex_state=conflict
        prerequisite_problem "Nonempty Codex override takes precedence over AGENTS.md: $codex_dir/AGENTS.override.md"
        return
    fi
    if [ -L "$codex_target" ] && [ "$codex_target" -ef "$codex_source" ]; then
        codex_state=correct
    elif [ -e "$codex_target" ] || [ -L "$codex_target" ]; then
        codex_state=conflict
        prerequisite_problem "Codex instructions target conflict; no replacement or backup: $codex_target"
    fi
}

if [ "$link_codex" -eq 1 ] || [ "$preview" -eq 1 ]; then
    check_codex_link
fi
if [ "$install" -eq 1 ] || [ "$preview" -eq 1 ]; then
    [ -f "$brewfile" ] || fail "Missing regular Brewfile: $brewfile"
    if command -v brew >/dev/null 2>&1; then
        prefix=$(brew --prefix)
        status=$?
        if [ "$status" -ne 0 ] || [ -z "$prefix" ] || [ ! -d "$prefix" ]; then
            prerequisite_problem 'brew --prefix must return an existing directory'
        fi
    else
        prerequisite_problem 'brew is unavailable on PATH; install Homebrew separately'
    fi
    if command -v xcode-select >/dev/null 2>&1; then
        if ! xcode-select -p >/dev/null 2>&1; then
            prerequisite_problem 'Apple developer tools are unavailable (xcode-select -p failed)'
        fi
    else
        prerequisite_problem 'xcode-select is unavailable on PATH'
    fi
fi
if [ "$link" -eq 1 ] || [ "$preview" -eq 1 ]; then
    check_links
fi
if [ "$link_skills" -eq 1 ] || [ "$preview" -eq 1 ]; then
    check_skills_link
fi

if [ "$preview" -eq 1 ]; then
    printf 'Preview only; no changes.\n'
fi
if [ "$install" -eq 1 ] || [ "$preview" -eq 1 ]; then
    printf 'Install plan: brew bundle install --no-upgrade --file=%s\n' "$brewfile"
    printf 'Disable automatic updates, analytics, install-time and inherited Bundle cleanup.\n'
fi
if [ "$link" -eq 1 ] || [ "$preview" -eq 1 ]; then
    for name in "${names[@]}"; do
        check_target "$name"
        printf 'Link plan (%s): %s -> %s\n' "$target_state" "$user_dir/$name" "$repo/.vscode/$name"
    done
    if [ "$backup" -eq 1 ]; then
        printf 'Backup plan: preserve conflicts in %s/vscode.XXXXXXXX only if needed.\n' "$backup_base"
    fi
fi
if [ "$link_skills" -eq 1 ] || [ "$preview" -eq 1 ]; then
    printf 'Agent skills link plan (%s): %s -> %s\n' "$skills_state" "$skills_target" "$skills_source"
fi
if [ "$link_codex" -eq 1 ] || [ "$preview" -eq 1 ]; then
    printf 'Codex instructions link plan (%s): %s -> %s\n' "$codex_state" "$codex_target" "$codex_source"
fi
[ "$preview" -eq 0 ] || exit 0

if [ "$install" -eq 1 ]; then
    (
        unset HOMEBREW_BUNDLE_FORCE_INSTALL_CLEANUP HOMEBREW_BUNDLE_INSTALL_CLEANUP
        export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_INSTALL_CLEANUP=1
        brew bundle install --no-upgrade --file="$brewfile"
    )
    status=$?
    [ "$status" -eq 0 ] || fail "Brew installation failed (status $status); no links attempted" "$status"
fi

if [ "$link" -eq 1 ]; then
    check_links
    umask 077
    for name in "${names[@]}"; do
        check_parents "$user_dir"
        [ "$backup" -eq 0 ] || check_parents "$backup_base"
        check_target "$name"
        [ "$target_state" != correct ] || continue
        if [ ! -d "$user_dir" ]; then
            mkdir -p "$user_dir" || fail "Cannot create VS Code directory: $user_dir"
        fi
        check_parents "$user_dir"
        check_target "$name"
        [ "$target_state" != correct ] || continue
        if [ "$target_state" = conflict ]; then
            if [ -z "$backup_dir" ]; then
                check_parents "$backup_base"
                mkdir -p "$backup_base" || fail "Cannot create backup base: $backup_base"
                check_parents "$backup_base"
                backup_dir=$(mktemp -d "$backup_base/vscode.XXXXXXXX") || fail 'Cannot create unique backup directory'
                check_parents "$backup_dir"
                chmod 700 "$backup_dir" || fail 'Cannot secure backup directory'
                printf 'Preserved backups will be in: %s\n' "$backup_dir"
            fi
            check_parents "$backup_dir"
            check_parents "$user_dir"
            check_target "$name"
            [ "$target_state" != correct ] || continue
            if [ "$target_state" = conflict ]; then
                if [ -e "$backup_dir/$name" ] || [ -L "$backup_dir/$name" ]; then
                    fail "Backup destination already exists: $backup_dir/$name"
                fi
                mv "$user_dir/$name" "$backup_dir/$name" || fail "Cannot preserve original: $user_dir/$name"
            fi
        fi
        check_parents "$user_dir"
        check_target "$name"
        [ "$target_state" != correct ] || continue
        [ "$target_state" = new ] || fail "Target changed before linking: $user_dir/$name"
        ln -s "$repo/.vscode/$name" "$user_dir/$name" || fail "Cannot create link: $user_dir/$name"
        printf 'Linked: %s\n' "$user_dir/$name"
    done
fi

if [ "$link_skills" -eq 1 ]; then
    check_skills_link
    if [ "$skills_state" != correct ]; then
        umask 077
        if [ ! -d "$agents_dir" ]; then
            mkdir -p "$agents_dir" || fail "Cannot create agent directory: $agents_dir"
        fi
        check_skills_link
        if [ "$skills_state" != correct ]; then
            ln -s "$skills_source" "$skills_target" || fail "Cannot create agent skills link: $skills_target"
            printf 'Linked: %s\n' "$skills_target"
        fi
    fi
fi

if [ "$link_codex" -eq 1 ]; then
    check_codex_link
    if [ "$codex_state" != correct ]; then
        umask 077
        if [ ! -d "$codex_dir" ]; then
            mkdir -p "$codex_dir" || fail "Cannot create Codex directory: $codex_dir"
        fi
        check_codex_link
        if [ "$codex_state" != correct ]; then
            ln -s "$codex_source" "$codex_target" || fail "Cannot create Codex instructions link: $codex_target"
            printf 'Linked: %s\n' "$codex_target"
        fi
    fi
fi
