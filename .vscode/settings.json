{
    "editor.renderWhitespace": "all",
    "editor.formatOnSave": true,
    "debug.javascript.autoAttachFilter": "smart",
    "security.workspace.trust.untrustedFiles": "open",
    "notebook.editorOptionsCustomizations": {
        "editor.tabSize": 2,
        "editor.indentSize": 2
    },
    // Wraps after 72 characters
    "rewrap.wrappingColumn": 79,
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "u"
            ],
            "after": [],
            "commands": [
                {
                    "command": "undo",
                    "args": []
                }
            ]
        },
        {
            "before": [
                "<C-r>"
            ],
            "after": [],
            "commands": [
                {
                    "command": "redo",
                    "args": []
                }
            ]
        }
    ],
    "git.autofetch": true,
    "workbench.startupEditor": "none",
    "editor.formatOnPaste": true,
    "jupyter.askForKernelRestart": false,
    "[jupyter]": {
        "python.linting.enabled": false
    },
    "editor.accessibilitySupport": "off",
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
    },
    "black-formatter.args": [
        "--line-length",
        "100"
    ],
    "update.enableWindowsBackgroundUpdates": false,
    "git.enableSmartCommit": true,
    "editor.inlineSuggest.enabled": true,
    "github.copilot.enable": {
        "quarto": true,
        "*": false,
        "yaml": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": false,
        "sql": false,
        "jsonc": false,
        "ignore": false
    },
    "notebook.output.wordWrap": true,
    "settingsSync.ignoredExtensions": [
        "github.copilot-chat"
    ],
    "notebook.output.scrolling": false,
    "liveServer.settings.useLocalIp": true,
    "liveServer.settings.AdvanceCustomBrowserCmdLine": "",
    "editor.inlineSuggest.suppressSuggestions": true,
    "javascript.format.semicolons": "insert",
    "[javascriptreact]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "[sql]": {},
    "git.terminalGitEditor": true,
    "typescript.format.enable": false,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "remote.autoForwardPortsSource": "hybrid",
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact"
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
    },
    "svelte.enable-ts-plugin": true,
    "update.mode": "manual",
    "remoteHub.uncommittedChangesOnEntry": "none",
    "github.copilot.chat.scopeSelection": true,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "vscode-neovim.compositeKeys": {
        "jk": {
            "command": "vscode-neovim.escape",
        },
    },
    "github.copilot.advanced": {},
    "typescript.updateImportsOnFileMove.enabled": "always",
    "workbench.list.defaultFindMode": "highlight",
    "workbench.list.typeNavigationMode": "automatic",
    "explorer.confirmDragAndDrop": true,
    "explorer.confirmDelete": true,
    "files.exclude": {
        "**/.git": true
    },
    "explorer.confirmPasteNative": false,
    // "vim.leader": "<space>",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<C-w>",
                "o"
            ],
            "commands": [
                "workbench.action.closeSidebar",
                "workbench.action.closePanel",
                "workbench.action.closeAuxiliaryBar",
                "workbench.action.activityBarLocation.hide",
                "workbench.action.closeEditorsInOtherGroups"
            ]
        },
        {
            "before": [
                "<C-w>",
                "v"
            ],
            "command": "workbench.action.splitEditorRight"
        },
        {
            "before": [
                "<C-w>",
                "s"
            ],
            "command": "workbench.action.splitEditorDown"
        },
        {
            "before": [
                "<C-w>",
                "c"
            ],
            "command": "workbench.action.closeActiveEditor"
        },
        {
            "before": [
                "<C-w>",
                "h"
            ],
            "command": "workbench.action.focusLeftGroup"
        },
        {
            "before": [
                "<C-w>",
                "j"
            ],
            "command": "workbench.action.focusBelowGroup"
        },
        {
            "before": [
                "<C-w>",
                "k"
            ],
            "command": "workbench.action.focusAboveGroup"
        },
        {
            "before": [
                "<C-w>",
                "l"
            ],
            "command": "workbench.action.focusRightGroup"
        },
        {
            "before": [
                "<C-w>",
                "w"
            ],
            "command": "workbench.action.focusNextGroup"
        },
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        },
        {
            "before": [
                "g",
                "K"
            ],
            "commands": [
                "editor.action.peekDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "editor.action.referenceSearch.trigger"
            ]
        },
        {
            "when": "editorTextFocus && editorLangId == 'typescript'",
            "before": [
                "g",
                "s"
            ],
            "commands": [
                "typescript.goToSourceDefinition"
            ]
        },
        {
            "when": "editorTextFocus && editorLangId == 'typescriptreact'",
            "before": [
                "g",
                "s"
            ],
            "commands": [
                "typescript.goToSourceDefinition"
            ]
        },
        {
            "when": "editorTextFocus && editorLangId == 'c'",
            "before": [
                "g",
                "t"
            ],
            "commands": [
                "manpages.openFromCursor"
            ]
        },
        {
            "before": [
                "g",
                "l"
            ],
            "commands": [
                "editor.action.openLink"
            ],
            "when": "editorTextFocus && vim.mode == 'Normal'"
        },
        {
            "before": [
                "g",
                "h"
            ],
            "commands": [
                "editor.action.showDefinitionPreviewHover"
            ]
        },
        {
            "before": [
                "g",
                "m"
            ],
            "commands": [
                "mdnDocs.showMdnDocs"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "n"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "r"
            ],
            "commands": [
                "references-view.findReferences"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "O"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "g",
                "W"
            ],
            "commands": [
                "workbench.action.showAllSymbols"
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        }
    ],
    "whichkey.bindingOverrides": [
        {
            "keys": " ",
            "name": "Show open buffers",
            "type": "command",
            "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup"
        }
    ],
    "whichkey.bindings": [
        {
            "key": "/",
            "name": "Search...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "/",
                    "name": "Search in current buffer",
                    "command": "actions.find"
                },
                {
                    "key": "s",
                    "name": "Search in New Editor",
                    "command": "search.action.openNewEditorToSide"
                }
            ]
        },
        {
            "key": "e",
            "name": "Explorer",
            "command": "workbench.view.explorer"
        },
        {
            "key": "f",
            "name": "Format Document",
            "command": "editor.action.formatDocument"
        },
        {
            "key": "g",
            "name": "Git...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "g",
                    "name": "Source Control",
                    "command": "workbench.view.scm"
                },
                {
                    "key": "s",
                    "name": "Git Status",
                    "command": "workbench.view.scm"
                },
                {
                    "key": "b",
                    "name": "Blame/Toggle Blame",
                    "command": "gitlens.toggleFileBlame"
                },
                {
                    "key": "l",
                    "name": "Git Log",
                    "command": "git.viewHistory"
                },
                {
                    "key": "a",
                    "name": "Git Add Current File",
                    "command": "git.stage"
                },
                {
                    "key": "c",
                    "name": "Git Commit",
                    "command": "git.commit"
                },
                {
                    "key": "p",
                    "name": "Git Push",
                    "command": "git.push"
                },
                {
                    "key": "P",
                    "name": "Git Pull",
                    "command": "git.pull"
                },
                {
                    "key": "d",
                    "name": "Diff View",
                    "command": "git.openChange"
                },
                {
                    "key": "m",
                    "name": "Diff vs previous commit",
                    "command": "git.openChange"
                },
                {
                    "key": "r",
                    "name": "Git...",
                    "type": "bindings",
                    "bindings": [
                        {
                            "key": "h",
                            "name": "Reset Hunk",
                            "command": "git.revertSelectedRanges"
                        }
                    ]
                }
            ]
        },
        {
            "key": "b",
            "name": "Buffer...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "o",
                    "name": "Close other buffers",
                    "command": "workbench.action.closeOtherEditors"
                },
                {
                    "key": "d",
                    "name": "Close buffer",
                    "command": "workbench.action.closeActiveEditor"
                }
            ]
        },
        {
            "key": "s",
            "name": "Search/Symbol...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "h",
                    "name": "Search Help",
                    "command": "workbench.action.showCommands"
                },
                {
                    "key": "k",
                    "name": "Search Keymaps",
                    "command": "workbench.action.openGlobalKeybindings"
                },
                {
                    "key": "f",
                    "name": "Search Files",
                    "command": "workbench.action.quickOpen"
                },
                {
                    "key": "s",
                    "name": "Search Symbols",
                    "command": "workbench.action.showAllSymbols"
                },
                {
                    "key": "w",
                    "name": "Search current Word",
                    "command": "editor.action.addSelectionToNextFindMatch"
                },
                {
                    "key": "g",
                    "name": "Search by Grep",
                    "command": "workbench.action.findInFiles"
                },
                {
                    "key": "d",
                    "name": "Document Symbols",
                    "command": "workbench.action.gotoSymbol"
                },
                {
                    "key": "p",
                    "name": "Project Symbols",
                    "command": "workbench.action.showAllSymbols"
                },
                {
                    "key": "r",
                    "name": "Search Resume",
                    "command": "workbench.action.findInFiles"
                },
                {
                    "key": ".",
                    "name": "Search Recent Files",
                    "command": "workbench.action.openRecent"
                },
                {
                    "key": "n",
                    "name": "Search Neovim files",
                    "command": "workbench.action.quickOpen"
                }
            ]
        },
        {
            "key": "d",
            "name": "Debug...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "a",
                    "name": "Start Debugging",
                    "command": "workbench.action.debug.start"
                },
                {
                    "key": "c",
                    "name": "Continue",
                    "command": "workbench.action.debug.continue"
                },
                {
                    "key": "b",
                    "name": "Toggle Breakpoint",
                    "command": "editor.debug.action.toggleBreakpoint"
                },
                {
                    "key": "B",
                    "name": "Conditional Breakpoint",
                    "command": "editor.debug.action.conditionalBreakpoint"
                },
                {
                    "key": "t",
                    "name": "Stop Debugging",
                    "command": "workbench.action.debug.stop"
                },
                {
                    "key": "d",
                    "name": "Open Debug View",
                    "command": "workbench.view.debug"
                },
                {
                    "key": "r",
                    "name": "Restart Debugging",
                    "command": "workbench.action.debug.restart"
                },
                {
                    "key": "i",
                    "name": "Step Into",
                    "command": "workbench.action.debug.stepInto"
                },
                {
                    "key": "o",
                    "name": "Step Out",
                    "command": "workbench.action.debug.stepOut"
                },
                {
                    "key": "O",
                    "name": "Step Over",
                    "command": "workbench.action.debug.stepOver"
                },
                {
                    "key": "u",
                    "name": "Toggle Debug UI",
                    "command": "workbench.debug.action.toggleRepl"
                },
                {
                    "key": "e",
                    "name": "Evaluate Expression",
                    "command": "editor.debug.action.showDebugHover"
                }
            ]
        },
        {
            "key": "c",
            "name": "Copilot/Chat/Code...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "c",
                    "name": "Focus Copilot Chat",
                    "command": "workbench.panel.chat.view.copilot.focus"
                },
                {
                    "key": "d",
                    "name": "Close Chat",
                    "command": "workbench.action.closeAuxiliaryBar"
                },
                {
                    "key": "s",
                    "name": "Show Symbols (Trouble)",
                    "command": "workbench.action.gotoSymbol"
                },
                {
                    "key": "l",
                    "name": "LSP References",
                    "command": "references-view.findReferences"
                }
            ]
        },
        {
            "key": "x",
            "name": "Problems/Diagnostics...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "x",
                    "name": "Show All Problems",
                    "command": "workbench.actions.view.problems"
                },
                {
                    "key": "X",
                    "name": "Buffer Diagnostics",
                    "command": "workbench.actions.view.problems"
                },
                {
                    "key": "L",
                    "name": "Location List",
                    "command": "workbench.actions.view.problems"
                },
                {
                    "key": "Q",
                    "name": "Quickfix List",
                    "command": "workbench.actions.view.problems"
                }
            ]
        },
        {
            "key": "m",
            "name": "Bookmarks/Marks...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "t",
                    "name": "Toggle bookmark",
                    "command": "bookmarks.toggle"
                },
                {
                    "key": "l",
                    "name": "Toggle labeled bookmark",
                    "command": "bookmarks.toggleLabeled"
                },
                {
                    "key": "n",
                    "name": "Jump to next bookmark",
                    "command": "bookmarks.jumpToNext"
                },
                {
                    "key": "p",
                    "name": "Jump to previous bookmark",
                    "command": "bookmarks.jumpToPrevious"
                },
                {
                    "key": "b",
                    "name": "List bookmarks (current file)",
                    "command": "bookmarks.list"
                },
                {
                    "key": "a",
                    "name": "List bookmarks (all files)",
                    "command": "bookmarks.listFromAllFiles"
                },
                {
                    "key": "c",
                    "name": "Clear bookmarks (current file)",
                    "command": "bookmarks.clear"
                },
                {
                    "key": "x",
                    "name": "Clear bookmarks (all files)",
                    "command": "bookmarks.clearFromAllFiles"
                },
                {
                    "key": "r",
                    "name": "Run worksheet",
                    "command": "ts-worksheet.run"
                }
            ]
        },
        {
            "key": "q",
            "name": "Session/Quit...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "s",
                    "name": "Save session",
                    "command": "workbench.action.files.saveAll"
                },
                {
                    "key": "l",
                    "name": "Load last session",
                    "command": "workbench.action.reopenClosedEditor"
                },
                {
                    "key": "q",
                    "name": "Open diagnostic quickfix list",
                    "command": "workbench.actions.view.problems"
                }
            ]
        }
    ],
