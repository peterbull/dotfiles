                },
                {
                    "key": "l",
                    "name": "[L]oad last session",
                    "command": "workbench.action.reopenClosedEditor"
                }
            ]
        },
        // ── u → Undo tree (mirrors <leader>u → UndotreeToggle) ──────────────────────
        {
            "key": "u",
            "name": "Toggle [U]ndo Tree",
            "type": "command",
            "command": "workbench.action.showCommands"
        }
