{
    "editor.renderWhitespace": "all",
    "editor.formatOnSave": true,
    "debug.javascript.autoAttachFilter": "smart",
    "security.workspace.trust.untrustedFiles": "open",
    "notebook.editorOptionsCustomizations": {
        "editor.tabSize": 2,
        "editor.indentSize": 2
    },
    // Wraps after 72 characters
    "rewrap.wrappingColumn": 79,
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "k"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.normalModeKeyBindings": [
        {
            "before": [
                "u"
            ],
            "after": [],
            "commands": [
                {
                    "command": "undo",
                    "args": []
                }
            ]
        },
        {
            "before": [
                "<C-r>"
            ],
            "after": [],
            "commands": [
                {
                    "command": "redo",
                    "args": []
                }
            ]
        }
    ],
    "git.autofetch": true,
    "workbench.startupEditor": "none",
    "editor.formatOnPaste": true,
    "jupyter.askForKernelRestart": false,
    "[jupyter]": {
        "python.linting.enabled": false
    },
    "editor.accessibilitySupport": "off",
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
    },
    "black-formatter.args": [
        "--line-length",
        "100"
    ],
    "update.enableWindowsBackgroundUpdates": false,
    "git.enableSmartCommit": true,
    "editor.inlineSuggest.enabled": true,
    "github.copilot.enable": {
        "quarto": true,
        "*": false,
        "yaml": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": false,
        "sql": false,
        "jsonc": false,
        "ignore": false
    },
    "notebook.output.wordWrap": true,
    "settingsSync.ignoredExtensions": [
        "github.copilot-chat"
    ],
    "notebook.output.scrolling": false,
    "liveServer.settings.useLocalIp": true,
    "liveServer.settings.AdvanceCustomBrowserCmdLine": "",
    "editor.inlineSuggest.suppressSuggestions": true,
    "javascript.format.semicolons": "insert",
    "[javascriptreact]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "[sql]": {},
    "git.terminalGitEditor": true,
    "typescript.format.enable": false,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
    },
    "remote.autoForwardPortsSource": "hybrid",
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact"
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
    },
    "svelte.enable-ts-plugin": true,
    "update.mode": "manual",
    "remoteHub.uncommittedChangesOnEntry": "none",
    "github.copilot.chat.scopeSelection": true,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "vscode-neovim.compositeKeys": {
        "jk": {
            "command": "vscode-neovim.escape",
        },
    },
    "github.copilot.advanced": {},
    "typescript.updateImportsOnFileMove.enabled": "always",
    "workbench.list.defaultFindMode": "highlight",
    "workbench.list.typeNavigationMode": "automatic",
    "explorer.confirmDragAndDrop": true,
    "explorer.confirmDelete": true,
    "files.exclude": {
        "**/.git": true
    },
    "explorer.confirmPasteNative": false,
    // "vim.leader": "<space>",
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<C-w>",
                "o"
            ],
            "commands": [
                "workbench.action.closeSidebar",
                "workbench.action.closePanel",
                "workbench.action.closeAuxiliaryBar",
                "workbench.action.activityBarLocation.hide",
                "workbench.action.closeEditorsInOtherGroups"
            ]
        },
        {
            "before": [
                "<C-w>",
                "v"
            ],
            "command": "workbench.action.splitEditorRight"
        },
        {
            "before": [
                "<C-w>",
                "s"
            ],
            "command": "workbench.action.splitEditorDown"
        },
        {
            "before": [
                "<C-w>",
                "c"
            ],
            "command": "workbench.action.closeActiveEditor"
        },
        {
            "before": [
                "<C-w>",
                "h"
            ],
            "command": "workbench.action.focusLeftGroup"
        },
        {
            "before": [
                "<C-w>",
                "j"
            ],
            "command": "workbench.action.focusBelowGroup"
        },
        {
            "before": [
                "<C-w>",
                "k"
            ],
            "command": "workbench.action.focusAboveGroup"
        },
        {
            "before": [
                "<C-w>",
                "l"
            ],
            "command": "workbench.action.focusRightGroup"
        },
        {
            "before": [
                "<C-w>",
                "w"
            ],
            "command": "workbench.action.focusNextGroup"
        },
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        },
        {
            "before": [
                "g",
                "K"
            ],
            "commands": [
                "editor.action.peekDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "editor.action.referenceSearch.trigger"
            ]
        },
        {
            "when": "editorTextFocus && editorLangId == 'typescript'",
            "before": [
                "g",
                "s"
            ],
            "commands": [
                "typescript.goToSourceDefinition"
            ]
        },
        {
            "when": "editorTextFocus && editorLangId == 'typescriptreact'",
            "before": [
                "g",
                "s"
            ],
            "commands": [
                "typescript.goToSourceDefinition"
            ]
        },
        {
            "when": "editorTextFocus && editorLangId == 'c'",
            "before": [
                "g",
                "t"
            ],
            "commands": [
                "manpages.openFromCursor"
            ]
        },
        {
            "before": [
                "g",
                "l"
            ],
            "commands": [
                "editor.action.openLink"
            ],
            "when": "editorTextFocus && vim.mode == 'Normal'"
        },
        {
            "before": [
                "g",
                "h"
            ],
            "commands": [
                "editor.action.showDefinitionPreviewHover"
            ]
        },
        {
            "before": [
                "g",
                "m"
            ],
            "commands": [
                "mdnDocs.showMdnDocs"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "n"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "r"
            ],
            "commands": [
                "references-view.findReferences"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "O"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "g",
                "W"
            ],
            "commands": [
                "workbench.action.showAllSymbols"
            ]
        }
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<space>"
            ],
            "commands": [
                "whichkey.show"
            ]
        }
    ],
    //
    "whichkey.bindingOverrides": [
        {
            "keys": " ",
            "name": "Show open buffers",
            "type": "command",
            "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup"
        }
    ],
    "whichkey.bindings": [
        // ── <leader><leader> → buffers (mirrors <leader><leader> → telescope buffers) ──
        {
            "key": "<leader>",
            "name": "Find existing buffers",
            "type": "command",
            "command": "workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup"
        },
        // ── / → Search ────────────────────────────────────────────────────────────────
        {
            "key": "/",
            "name": "Search...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "/",
                    "name": "Search in current buffer",
                    "command": "actions.find"
                },
                {
                    "key": "s",
                    "name": "Search in New Editor",
                    "command": "search.action.openNewEditorToSide"
                }
            ]
        },
        // ── e → Explorer (mirrors <leader>e → mini.files) ────────────────────────────
        {
            "key": "e",
            "name": "Open File Explorer",
            "type": "command",
            "command": "workbench.view.explorer"
        },
        // ── f → Format buffer (mirrors <leader>f → conform.format) ──────────────────
        {
            "key": "f",
            "name": "Format buffer",
            "type": "command",
            "command": "editor.action.formatDocument"
        },
        // ── s → Search (mirrors telescope <leader>s* bindings) ───────────────────────
        {
            "key": "s",
            "name": "Search...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "h",
                    "name": "[S]earch [H]elp",
                    "command": "workbench.action.showCommands"
                },
                {
                    "key": "k",
                    "name": "[S]earch [K]eymaps",
                    "command": "workbench.action.openGlobalKeybindings"
                },
                {
                    "key": "f",
                    "name": "[S]earch [F]iles",
                    "command": "workbench.action.quickOpen"
                },
                {
                    "key": "F",
                    "name": "[S]earch all [F]iles (incl. hidden)",
                    "command": "workbench.action.quickOpen"
                },
                {
                    "key": "g",
                    "name": "[S]earch by [G]rep",
                    "command": "workbench.action.findInFiles"
                },
                {
                    "key": "G",
                    "name": "[S]earch by [G]rep (incl. tests)",
                    "command": "workbench.action.findInFiles"
                },
                {
                    "key": "w",
                    "name": "[S]earch current [W]ord",
                    "command": "editor.action.addSelectionToNextFindMatch"
                },
                {
                    "key": "d",
                    "name": "[S]earch [D]iagnostics / Document Symbols",
                    "command": "workbench.action.gotoSymbol"
                },
                {
                    "key": "r",
                    "name": "[S]earch [R]esume",
                    "command": "workbench.action.findInFiles"
                },
                {
                    "key": ".",
                    "name": "[S]earch Recent Files",
                    "command": "workbench.action.openRecent"
                },
                {
                    "key": "n",
                    "name": "[S]earch [N]eovim / config files",
                    "command": "workbench.action.quickOpen"
                },
                {
                    "key": "j",
                    "name": "[S]earch [J]umplist",
                    "command": "workbench.action.quickOpen"
                },
                {
                    "key": "m",
                    "name": "[S]earch [M]arks",
                    "command": "bookmarks.listFromAllFiles"
                },
                {
                    "key": "s",
                    "name": "[S]earch [S]ymbols (workspace)",
                    "type": "bindings",
                    "bindings": [
                        {
                            "key": "s",
                            "name": "Select Telescope picker",
                            "command": "workbench.action.showCommands"
                        },
                        {
                            "key": "w",
                            "name": "[S]ymbols [W]orkspace",
                            "command": "workbench.action.showAllSymbols"
                        },
                        {
                            "key": "d",
                            "name": "[S]ymbols [D]ocument",
                            "command": "workbench.action.gotoSymbol"
                        }
                    ]
                },
                {
                    "key": "a",
                    "name": "[S]earch [A]ll...",
                    "type": "bindings",
                    "bindings": [
                        {
                            "key": "f",
                            "name": "[S]earch [A]ll [F]iles (hidden)",
                            "command": "workbench.action.quickOpen"
                        },
                        {
                            "key": "g",
                            "name": "[S]earch in [A]ll files by [G]rep",
                            "command": "workbench.action.findInFiles"
                        }
                    ]
                }
            ]
        },
        // ── g → Git (mirrors <leader>g* diffview/gitsigns bindings) ─────────────────
        {
            "key": "g",
            "name": "Git...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "g",
                    "name": "Source Control",
                    "command": "workbench.view.scm"
                },
                {
                    "key": "s",
                    "name": "Git Status",
                    "command": "workbench.view.scm"
                },
                {
                    "key": "d",
                    "name": "[G]it [D]iff current file (toggle)",
                    "command": "git.openChange"
                },
                {
                    "key": "M",
                    "name": "[G]it diff vs [M]erge base",
                    "command": "git.openChange"
                },
                {
                    "key": "f",
                    "name": "[G]it [F]ile history",
                    "command": "git.viewHistory"
                },
                {
                    "key": "h",
                    "name": "[G]it [H]istory (all)",
                    "command": "git.viewHistory"
                },
                {
                    "key": "A",
                    "name": "[G]it [A]ll changes vs default branch",
                    "command": "git.openChange"
                },
                {
                    "key": "T",
                    "name": "[G]it diff between two [T]ags",
                    "command": "git.openChange"
                },
                {
                    "key": "b",
                    "name": "[G]it [B]lame (toggle)",
                    "command": "gitlens.toggleFileBlame"
                },
                {
                    "key": "a",
                    "name": "Git [A]dd current file",
                    "command": "git.stage"
                },
                {
                    "key": "c",
                    "name": "Git [C]ommit",
                    "command": "git.commit"
                },
                {
                    "key": "p",
                    "name": "Git [P]ush",
                    "command": "git.push"
                },
                {
                    "key": "P",
                    "name": "Git [P]ull",
                    "command": "git.pull"
                },
                {
                    "key": "r",
                    "name": "Git [R]eset...",
                    "type": "bindings",
                    "bindings": [
                        {
                            "key": "h",
                            "name": "Reset [H]unk",
                            "command": "git.revertSelectedRanges"
                        }
                    ]
                }
            ]
        },
        // ── b → Buffer (mirrors <leader>bd / <leader>bo) ─────────────────────────────
        {
            "key": "b",
            "name": "Buffer...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "d",
                    "name": "[D]elete current buffer",
                    "command": "workbench.action.closeActiveEditor"
                },
                {
                    "key": "o",
                    "name": "Close [O]ther buffers",
                    "command": "workbench.action.closeOtherEditors"
                }
            ]
        },
        // ── d → Debug (mirrors <leader>d* DAP bindings) ──────────────────────────────
        {
            "key": "d",
            "name": "Debug...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "a",
                    "name": "St[a]rt Debugging",
                    "command": "workbench.action.debug.start"
                },
                {
                    "key": "c",
                    "name": "[C]ontinue",
                    "command": "workbench.action.debug.continue"
                },
                {
                    "key": "b",
                    "name": "Toggle [B]reakpoint",
                    "command": "editor.debug.action.toggleBreakpoint"
                },
                {
                    "key": "B",
                    "name": "Conditional [B]reakpoint",
                    "command": "editor.debug.action.conditionalBreakpoint"
                },
                {
                    "key": "t",
                    "name": "S[t]op Debugging",
                    "command": "workbench.action.debug.stop"
                },
                {
                    "key": "r",
                    "name": "[R]estart Debugging",
                    "command": "workbench.action.debug.restart"
                },
                {
                    "key": "d",
                    "name": "Open [D]ebug View",
                    "command": "workbench.view.debug"
                },
                {
                    "key": "i",
                    "name": "Step [I]nto",
                    "command": "workbench.action.debug.stepInto"
                },
                {
                    "key": "o",
                    "name": "Step [O]ut",
                    "command": "workbench.action.debug.stepOut"
                },
                {
                    "key": "O",
                    "name": "Step [O]ver",
                    "command": "workbench.action.debug.stepOver"
                },
                {
                    "key": "u",
                    "name": "Toggle Debug [U]I",
                    "command": "workbench.debug.action.toggleRepl"
                },
                {
                    "key": "U",
                    "name": "Reset Debug [U]I",
                    "command": "workbench.debug.action.toggleRepl"
                },
                {
                    "key": "e",
                    "name": "[E]val / Evaluate Expression",
                    "command": "editor.debug.action.showDebugHover"
                }
            ]
        },
        // ── x → Trouble / Diagnostics (mirrors <leader>x* trouble.nvim) ─────────────
        {
            "key": "x",
            "name": "Diagnostics/Trouble...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "x",
                    "name": "Current Line Diagnostics",
                    "command": "workbench.actions.view.problems"
                },
                {
                    "key": "X",
                    "name": "Buffer Diagnostics",
                    "command": "workbench.actions.view.problems"
                },
                {
                    "key": "X",
                    "name": "All Buffers Diagnostics",
                    "command": "workbench.actions.view.problems"
                },
                {
                    "key": "L",
                    "name": "Location List",
                    "command": "workbench.actions.view.problems"
                },
                {
                    "key": "Q",
                    "name": "Quickfix List",
                    "command": "workbench.actions.view.problems"
                }
            ]
        },
        // ── c → Code / Custom / Copilot (mirrors <leader>c* + trouble cs/cl) ─────────
        {
            "key": "c",
            "name": "Code/Custom/Copilot...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "c",
                    "name": "Focus Copilot Chat",
                    "command": "workbench.panel.chat.view.copilot.focus"
                },
                {
                    "key": "d",
                    "name": "Close Chat / Aux Bar",
                    "command": "workbench.action.closeAuxiliaryBar"
                },
                {
                    "key": "s",
                    "name": "[C]ode [S]ymbols (Trouble)",
                    "command": "workbench.action.gotoSymbol"
                },
                {
                    "key": "l",
                    "name": "LSP References (Trouble)",
                    "command": "references-view.findReferences"
                },
                {
                    "key": "f",
                    "name": "Run [C]ustom [F]unction",
                    "command": "workbench.action.showCommands"
                },
                {
                    "key": "d",
                    "name": "[C]opy buffer [D]irectory",
                    "command": "copyRelativeFilePath"
                }
            ]
        },
        // ── r → REPL (mirrors <leader>r* iron.nvim keymaps) ─────────────────────────
        {
            "key": "r",
            "name": "REPL...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "r",
                    "name": "Toggle REPL",
                    "command": "workbench.action.terminal.toggleTerminal"
                },
                {
                    "key": "R",
                    "name": "Restart REPL / Kernel",
                    "command": "jupyter.restartkernel"
                },
                {
                    "key": "l",
                    "name": "Send current [L]ine",
                    "command": "jupyter.execSelectionInteractive"
                },
                {
                    "key": "c",
                    "name": "Send selection / motion",
                    "command": "jupyter.execSelectionInteractive"
                },
                {
                    "key": "F",
                    "name": "Send entire [F]ile",
                    "command": "jupyter.runAllCells"
                },
                {
                    "key": "b",
                    "name": "Send code [B]lock",
                    "command": "jupyter.runCurrentCell"
                },
                {
                    "key": "n",
                    "name": "Send block and move [N]ext",
                    "command": "jupyter.runCurrentCellAndAdvance"
                },
                {
                    "key": "i",
                    "name": "[I]nterrupt REPL",
                    "command": "jupyter.interruptkernel"
                },
                {
                    "key": "f",
                    "name": "[F]ocus REPL",
                    "command": "workbench.action.terminal.focus"
                },
                {
                    "key": "h",
                    "name": "[H]ide REPL",
                    "command": "workbench.action.terminal.toggleTerminal"
                }
            ]
        },
        // ── h → Harpoon (mirrors <leader>h* harpoon2 bindings) ───────────────────────
        {
            "key": "h",
            "name": "Harpoon...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "a",
                    "name": "[A]dd to harpoon",
                    "command": "workbench.action.pinEditor"
                },
                {
                    "key": "c",
                    "name": "[C]lear harpoon",
                    "command": "workbench.action.unpinEditor"
                },
                {
                    "key": "h",
                    "name": "Open [H]arpoon list",
                    "command": "workbench.action.showAllEditors"
                }
            ]
        },
        // ── t → Treesitter / Toggles (mirrors <leader>t* + <leader>th / <leader>tt) ──
        {
            "key": "t",
            "name": "Treesitter/Toggles...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "i",
                    "name": "Toggle Treesitter [I]nspect",
                    "command": "editor.action.inspectTMScopes"
                },
                {
                    "key": "h",
                    "name": "Toggle Inlay [H]ints",
                    "command": "editor.action.inlayHints.toggle"
                },
                {
                    "key": "t",
                    "name": "Toggle [T]erminal / cmdheight",
                    "command": "workbench.action.terminal.toggleTerminal"
                },
                {
                    "key": "H",
                    "name": "Toggle Terminal (Bottom)",
                    "command": "workbench.action.terminal.toggleTerminal"
                }
            ]
        },
        // ── m → Marks / Bookmarks (mirrors <leader>m* bookmarks) ────────────────────
        {
            "key": "m",
