                {
                    "key": "d",
                    "name": "List GitHub [D]iscussions",
                    "command": "workbench.action.showCommands"
                },
                {
                    "key": "n",
                    "name": "List GitHub [N]otifications",
                    "command": "workbench.action.showCommands"
                },
                {
                    "key": "s",
                    "name": "[S]earch GitHub",
                    "command": "workbench.action.showCommands"
                }
            ]
        },
        // ── q → Session/Quickfix (mirrors <leader>q → diagnostic quickfix) ──────────
        {
            "key": "q",
            "name": "Session/Quickfix...",
            "type": "bindings",
            "bindings": [
                {
                    "key": "q",
                    "name": "Open diagnostic [Q]uickfix list",
