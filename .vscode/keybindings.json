// Place your key bindings in this file to override the defaults
[
    // ─── Notebook ────────────────────────────────────────────────────────────
    {
        "key": "cmd+; cmd+.",
        "command": "notebook.cell.clearOutputs",
        "when": "notebookCellEditable && notebookCellHasOutputs && notebookEditable && notebookEditorFocused && !inputFocus"
    },
    {
        "key": "alt+delete",
        "command": "-notebook.cell.clearOutputs",
        "when": "notebookCellEditable && notebookCellHasOutputs && notebookEditable && notebookEditorFocused && !inputFocus"
    },
    {
        "key": "cmd+; cmd+.",
        "command": "notebook.clearAllCellsOutputs"
    },
    {
        "key": "cmd+' cmd+/",
        "command": "deno.kernel.restart"
    },
    {
        "key": "cmd+' cmd+/",
        "command": "jupyter.restartkernel"
    },
    {
        "key": "cmd+' cmd+/",
        "command": "deno.kernel.restart",
        "when": "isWorkspaceTrusted && notebookType == 'nbts'"
    },
    {
        "key": "shift+alt+-",
        "command": "notebook.cell.executeCellsAbove"
    },
    {
        "key": "shift+p",
        "command": "notebook.toggleLineNumbers",
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "shift+l",
        "command": "-notebook.toggleLineNumbers",
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "l",
        "command": "-notebook.cell.toggleLineNumbers",
        "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused"
    },
    {
        "key": "ctrl+alt+c",
        "command": "notebook.cellOutput.copy"
    },
    // ─── Window / Pane Navigation (mirrors <C-h/j/k/l> → <C-w><C-h/j/k/l>) ─
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft",
        "when": "!inDebugMode || (inDebugMode && activeViewlet != 'workbench.view.debug')"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown",
        "when": "!hasSearchResult && !inSearchEditor && !searchViewletFocus && !activeViewlet == 'workbench.view.scm'"
    },
    // ─── Window Resizing (mirrors <C-A-h/j/k/l>) ─────────────────────────────
    {
        "key": "ctrl+alt+h",
        "command": "workbench.action.decreaseViewWidth"
    },
    {
        "key": "ctrl+alt+l",
        "command": "workbench.action.increaseViewWidth"
    },
    {
        "key": "ctrl+alt+j",
        "command": "workbench.action.decreaseViewHeight"
    },
    {
        "key": "ctrl+alt+k",
        "command": "workbench.action.increaseViewHeight"
    },
    // ─── Debug pane navigation ────────────────────────────────────────────────
    {
        "key": "ctrl+h",
        "command": "workbench.debug.action.focusVariablesView",
        "when": "inDebugMode && activeViewlet == 'workbench.view.debug' && (debugState == 'running' || debugState == 'stopped') && workbench.debug.variablesView.visible"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.debug.action.focusCallStackView",
        "when": "inDebugMode && activeViewlet == 'workbench.view.debug' && (debugState == 'running' || debugState == 'stopped') && !workbench.debug.callStackView.focused"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.debug.action.focusVariablesView",
        "when": "inDebugMode && activeViewlet == 'workbench.view.debug' && (debugState == 'running' || debugState == 'stopped') && !workbench.debug.variablesView.focused"
    },
    // ─── SCM navigation ───────────────────────────────────────────────────────
    {
        "key": "ctrl+h",
        "command": "workbench.scm.action.focusNextResourceGroup",
        "when": "editorTextFocus && activeViewlet == 'workbench.view.scm' && sideBarVisible && !searchViewletFocus && !inSearchEditor && !hasSearchResult"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "resourceScheme =~ /scminput/ && activeViewlet == 'workbench.view.scm' && !searchViewletFocus && !inSearchEditor"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.scm.action.focusNextResourceGroup",
        "when": "resourceScheme =~ /scminput/ && activeViewlet == 'workbench.view.scm' && !searchViewletFocus && !inSearchEditor"
    },
    // ─── Return focus to editor (mirrors <C-;> → focus editor) ───────────────
    {
        "key": "ctrl+;",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "!editorFocus"
    },
    // ─── Terminal toggle (mirrors <C-\> toggleterm) ───────────────────────────
    {
        "key": "ctrl+\\",
        "command": "workbench.action.terminal.toggleTerminal"
    },
    // shift+enter in terminal → line continuation (kept from original)
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\\\r\n"
        },
        "when": "terminalFocus"
    },
    // ─── Explorer (mirrors mini.files / netrw conventions) ───────────────────
    {
        "key": "enter",
        "command": "list.select",
        "when": "explorerViewFocus && !inputFocus"
    },
    {
        "key": "cmd+enter",
        "command": "renameFile",
        "when": "explorerViewFocus && !inputFocus"
    },
    {
        "key": "n",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+n",
        "command": "explorer.newFolder",
        "when": "filesExplorerFocus && !inputFocus"
    },
    // r → rename (mirrors nvim explorer rename)
    {
        "key": "r",
        "command": "renameFile",
        "when": "explorerViewletFocus && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    // ─── Hover scrolling (mirrors j/k/ctrl+d/ctrl+u in hover) ────────────────
    {
        "key": "k",
        "command": "editor.action.scrollUpHover",
        "when": "editorHoverFocused"
    },
    {
        "key": "j",
        "command": "editor.action.scrollDownHover",
        "when": "editorHoverFocused"
    },
    {
        "key": "ctrl+u",
        "command": "editor.action.pageUpHover",
        "when": "editorHoverFocused"
    },
    {
        "key": "ctrl+d",
        "command": "editor.action.pageDownHover",
        "when": "editorHoverFocused"
    },
    // ─── LSP: shift+K → hover doc (mirrors vim.lsp / gK peek) ───────────────
    // shift+k in normal mode → showDefinitionPreviewHover (like K in nvim)
    {
        "key": "shift+k",
        "command": "editor.action.showDefinitionPreviewHover"
    },
    // ─── LSP: gl → open diagnostic float ─────────────────────────────────────
    // Mapped via vim normalModeKeyBindings in settings.json (gl → openLink conflicts)
    // Using alt+d as a VSCode-native fallback for diagnostic float
    {
        "key": "alt+d",
        "command": "editor.action.showHover",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    // ─── Quickfix navigation (mirrors ]q / [q) ────────────────────────────────
    {
        "key": "shift+cmd+]",
        "command": "editor.action.marker.next",
        "when": "editorFocus"
    },
    {
        "key": "shift+cmd+[",
        "command": "editor.action.marker.prev",
        "when": "editorFocus"
    },
    // ─── Search / Viewlet navigation ─────────────────────────────────────────
    {
        "key": "ctrl+j",
        "command": "list.focusDown",
        "when": "searchViewletFocus"
    },
    {
        "key": "ctrl+k",
        "command": "search.focus.previousInputBox",
        "when": "searchViewletFocus && !inputBoxFocus"
    },
    {
        "key": "ctrl+j",
        "command": "search.focus.nextInputBox",
        "when": "inSearchEditor && inputBoxFocus || inputBoxFocus && searchViewletVisible"
    },
    {
        "key": "cmd+down",
        "command": "-search.focus.nextInputBox",
        "when": "inSearchEditor && inputBoxFocus || inputBoxFocus && searchViewletVisible"
    },
    {
        "key": "ctrl+k",
        "command": "search.action.focusQueryEditorWidget",
        "when": "inSearchEditor"
    },
    {
        "key": "escape",
        "command": "-search.action.focusQueryEditorWidget",
        "when": "inSearchEditor"
    },
    // ─── Chat / Copilot navigation ────────────────────────────────────────────
    {
        "key": "ctrl+k",
        "command": "chat.action.focusLastCodeBlock",
        "when": "inChat && chatInputFocus"
    },
    {
        "key": "ctrl+j",
        "command": "chat.action.focusNextCodeBlock",
        "when": "inChat && chatFocused"
    },
    {
        "key": "ctrl+k",
        "command": "chat.action.focusPreviousCodeBlock",
        "when": "inChat && chatFocused && !chatInputFocus"
    },
    // ─── Notifications / Messages ─────────────────────────────────────────────
    {
        "key": "escape",
        "command": "notifications.hideToasts",
        "when": "notificationToastsVisible"
    },
    {
        "key": "escape",
        "command": "workbench.action.closeMessages",
        "when": "globalMessageVisible"
    },
    // ─── Debug console autocomplete ───────────────────────────────────────────
    {
        "key": "enter",
        "command": "acceptSelectedSuggestion",
        "when": "suggestWidgetVisible && textInputFocus && debugConsoleInputFocus"
    },
    {
        "key": "shift+enter",
        "command": "repl.action.acceptInput",
        "when": "suggestWidgetVisible && textInputFocus && debugConsoleInputFocus"
    },
    // ─── Inline suggestion accept: ctrl+y (mirrors <C-y> in nvim/blink) ──────
    {
        "key": "ctrl+y",
        "command": "-extension.vim_ctrl+y",
        "when": "editorTextFocus && vim.active && vim.use<C-y> && !inDebugRepl"
    },
    {
        "key": "ctrl+y",
        "command": "editor.action.inlineSuggest.commit",
        "when": "inlineEditIsVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible"
    },
    {
        "key": "tab",
        "command": "-editor.action.inlineSuggest.commit",
        "when": "inlineEditIsVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible || inlineEditIsVisible && inlineSuggestionVisible && tabShouldAcceptInlineEdit && !editorHoverFocused && !editorTabMovesFocus && !suggestWidgetVisible"
    },
    {
        "key": "ctrl+y",
        "command": "editor.action.inlineSuggest.commit",
        "when": "inInlineEditsPreviewEditor"
    },
    {
        "key": "tab",
        "command": "-editor.action.inlineSuggest.commit",
        "when": "inInlineEditsPreviewEditor"
    },
    {
        "key": "ctrl+y",
        "command": "acceptSelectedSuggestion",
        "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "tab",
        "command": "-acceptSelectedSuggestion",
        "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "ctrl+y",
        "command": "workbench.action.terminal.acceptSelectedSuggestion",
        "when": "terminalFocus && terminalHasBeenCreated && terminalIsOpen && terminalSuggestWidgetVisible || terminalFocus && terminalIsOpen && terminalProcessSupported && terminalSuggestWidgetVisible"
    },
    {
        "key": "tab",
        "command": "-workbench.action.terminal.acceptSelectedSuggestion",
        "when": "terminalFocus && terminalHasBeenCreated && terminalIsOpen && terminalSuggestWidgetVisible || terminalFocus && terminalIsOpen && terminalProcessSupported && terminalSuggestWidgetVisible"
    },
    // ─── Breakpoints ──────────────────────────────────────────────────────────
    {
        "key": "shift+cmd+8 shift+cmd+6",
        "command": "workbench.debug.viewlet.action.removeAllBreakpoints"
    },
    {
        "key": "shift+alt+8 shift+alt+6",
        "command": "workbench.debug.viewlet.action.disableAllBreakpoints"
    },
    {
        "key": "shift+alt+7 shift+alt+5",
        "command": "workbench.debug.viewlet.action.enableAllBreakpoints"
    },
    {
        "key": "shift+cmd+f9",
        "command": "-workbench.action.chat.previousFileTree",
        "when": "chatIsEnabled && inChat"
    },
    {
        "key": "shift+cmd+f9",
        "command": "editor.debug.action.conditionalBreakpoint"
    },
    {
        "key": "shift+alt+f9",
        "command": "-editor.action.previousCommentThreadAction"
    },
    {
        "key": "shift+alt+f9",
        "command": "editor.debug.action.editBreakpoint"
    },
    // ─── Misc ─────────────────────────────────────────────────────────────────
    {
        "key": "cmd+p",
        "command": "workbench.action.quickOpen",
        "when": "!editorFocus && !inputFocus"
    },
    {
        "key": "cmd+p",
        "command": "-workbench.action.quickOpen"
    },
    {
        "key": "shift+alt+0 shift+alt+0",
        "command": "editor.debug.action.selectionToWatch"
    },
    {
        "key": "alt+r",
        "command": "rust-analyzer.debug"
    },
    {
        "key": "alt+c",
        "command": "code-to-clipboard.copyCurrentTabCode"
    },
    {
        "key": "shift+alt+c",
        "command": "code-to-clipboard.copyCode"
    },
    {
        "key": "cmd+l cmd+l",
        "command": "dataWrangler.openNotebookVariable"
    }
    /*
    USEFUL CONTEXT KEYS FOR SCM AND NAVIGATION:

    SCM Context Keys:
    - resourceScheme =~ /scminput/ : Currently focused on SCM input box
    - scmRepository : SCM repository is available
    - scmActiveResourceHasChanges : Active resource has changes
    - scmProviderCount : Number of SCM providers
    - scmInputIsInFirstPosition : Cursor at first position in SCM input
    - scmInputIsInLastPosition : Cursor at last position in SCM input

    Editor Context Keys:
    - editorTextFocus : Editor text area has focus
    - editorFocus : Editor or editor widget has focus
    - textInputFocus : Any text input has focus
    - !editorFocus : NOT in editor

    List/Tree Context Keys:
    - listFocus : List widget has focus
    - treeFocus : Tree widget has focus
    - explorerViewletFocus : Explorer sidebar is focused
    - searchViewletFocus : Search sidebar is focused

    View Context Keys:
    - activeViewlet == 'workbench.view.scm' : SCM view is active
    - sideBarFocus : Any sidebar has focus
    - panelFocus : Bottom panel has focus

    General Context Keys:
    - inputFocus : Any input field has focus
    - !inputFocus : NOT in an input field
    - suggestWidgetVisible : Autocomplete suggestions visible
    - renameInputVisible : File rename input is visible

    Debug Context Keys:
    - inDebugMode : Debug session is active
    - debugState == 'stopped' : Debugger is stopped at breakpoint

    Vim Extension Context Keys (if using VSCode Vim):
    - vim.active : Vim extension is active
    - vim.mode != 'Insert' : Not in vim insert mode
    - vim.mode != 'Replace' : Not in vim replace mode
    */
]